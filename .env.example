# Copy to .env and fill in your own Alpaca PAPER keys. Never commit .env.
APCA_API_KEY_ID=your_paper_key_here
APCA_API_SECRET_KEY=your_paper_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets
TICKER=AAPL
USE_RL=true
USE_GNN=true
PAPER_TRADING_INTERVAL_SEC=60
PAPER_TRADING_MAX_POSITION=1.0
PAPER_TRADING_LOOKBACK_YEARS=5
