            columns=self.feature_names,
            index=X.index,
        )
        return result
    
    def fit_transform(self, X: pd.DataFrame, y=None) -> pd.DataFrame:
        """Fit and transform."""
        return self.transform(X)
    
    def get_feature_names(self) -> List[str]:
        """Get feature names."""
        return self.feature_names


