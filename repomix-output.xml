        """Load data for a symbol."""
        self.call_count += 1
        if symbol in self.data:
            return self.data[symbol].copy()
        raise ValueError(f"No data for symbol: {symbol}")
    
    def get_symbols(self) -> List[str]:
        """Get available symbols."""
